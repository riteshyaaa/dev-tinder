# ===== DevTinder Backend Environment Variables =====
# Copy this file to .env and fill in your values

# MongoDB Atlas Connection
# Option 1: Separate username/password (current setup)
MONGO_DB_USERNAME=your_atlas_username
MONGO_DB_PASSWORD=your_atlas_password

# Option 2: Full connection string (Railway/Render provide this)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/devtinder

# JWT Secret Key (use a strong random string in production)
JWT_SECRET=your_jwt_secret_key_here

# Server Port
PORT=3000

# CORS Origin (frontend URL)
# Development:
CORS_ORIGIN=http://localhost:5173
# Production:
# CORS_ORIGIN=https://your-frontend-domain.vercel.app

# Node Environment
NODE_ENV=development
