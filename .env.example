# ===== DevTinder Backend Environment Variables =====
# Copy this file to .env and fill in your values

# MongoDB Connection
MONGO_DB_USERNAME=your_atlas_username
MONGO_DB_PASSWORD=your_atlas_password
# OR use full URI (Railway/Render provide this):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/devtinder

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Server
PORT=3000
NODE_ENV=development

# CORS Origin (frontend URL)
CORS_ORIGIN=http://localhost:5173
# Production: CORS_ORIGIN=https://your-frontend.vercel.app

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173

# Cloudinary (server-side signed uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (SMTP - for password reset, match notifications)
# Use Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
# Or Mailtrap for testing: smtp.mailtrap.io
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DevTinder <noreply@devtinder.dev>

# Admin (comma-separated admin emails)
ADMIN_EMAILS=admin@devtinder.dev

# Redis (optional - for production caching)
# REDIS_URL=redis://localhost:6379
